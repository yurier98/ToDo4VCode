{
    "name": "todo4vcode",
    "displayName": "ToDo4VCode",
    "description": "TODO extension for VS Code: task manager with List, Kanban, and Calendar planning, priorities, due dates, reminders, and code-linked tasks.",
    "version": "1.3.1",
    "publisher": "YurierHerrera",
    "author": "Yurier Herrera",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yurier98/ToDo4VCode.git"
    },
    "homepage": "https://github.com/yurier98/ToDo4VCode/blob/main/README.md",
    "bugs": {
        "url": "https://github.com/yurier98/ToDo4VCode/issues",
        "email": "yurierjesus@gmail.com"
    },
    "qna": "marketplace",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "keywords": [
        "todo",
        "todo-list",
        "todo-extension",
        "vscode-todo",
        "task-manager",
        "task-list",
        "task-planner",
        "project-planning",
        "productivity",
        "kanban",
        "calendar",
        "reminders",
        "due-date",
        "moscow-priority",
        "code-tasks",
        "developer-tools",
        "todo4vcode",
        "cursor"
    ],
    "main": "./out/extension.js",
    "icon": "media/icon.png",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "todo4vcode-explorer",
                    "title": "Priority Tasks",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "views": {
            "todo4vcode-explorer": [
                {
                    "type": "webview",
                    "id": "todo4vcode-view",
                    "name": "Tasks",
                    "icon": "./media/icon.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "todo4vcode.refresh",
                "title": "Refresh Tasks",
                "icon": "$(refresh)"
            },
            {
                "command": "todo4vcode.openFull",
                "title": "Open in full screen",
                "icon": "$(screen-full)"
            },
            {
                "command": "todo4vcode.openConfig",
                "title": "Open Settings",
                "icon": "$(settings-gear)"
            },
            {
                "command": "todo4vcode.addSelectionAsTask",
                "title": "ToDo4VCode: Add Selection as New Task"
            },
            {
                "command": "todo4vcode.attachSelectionToTask",
                "title": "ToDo4VCode: Attach Selection to Existing Task"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "todo4vcode.openFull",
                    "when": "view == todo4vcode-view",
                    "group": "navigation"
                },
                {
                    "command": "todo4vcode.openConfig",
                    "when": "view == todo4vcode-view",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "todo4vcode.addSelectionAsTask",
                    "when": "editorTextFocus && editorHasSelection",
                    "group": "navigation@10"
                },
                {
                    "command": "todo4vcode.attachSelectionToTask",
                    "when": "editorTextFocus && editorHasSelection",
                    "group": "navigation@11"
                }
            ]
        },
        "configuration": {
            "title": "ToDo4VCode",
            "properties": {
                "todo4vcode.hideCompleted": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hide completed tasks from the list."
                },
                "todo4vcode.defaultPriority": {
                    "type": "string",
                    "enum": [
                        "Must",
                        "Should",
                        "Could",
                        "Wont"
                    ],
                    "default": "Should",
                    "description": "Default priority for new tasks."
                },
                "todo4vcode.stats.showTotal": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show total number of tasks in statistics panel."
                },
                "todo4vcode.stats.showDone": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show number of completed (Done) tasks in statistics panel."
                },
                "todo4vcode.stats.showMust": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show number of Must priority tasks in statistics panel."
                },
                "todo4vcode.stats.showInProgress": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show number of In Progress tasks in statistics panel."
                },
                "todo4vcode.stats.showOverdue": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show number of overdue tasks in statistics panel."
                },
                "todo4vcode.reminders.playSound": {
                    "type": "boolean",
                    "default": true,
                    "description": "Play a sound when a task reminder is triggered."
                },
                "todo4vcode.commentScan.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically scan workspace files for // TODO, // FIXME and // NOTE comments and import them as tasks."
                },
                "todo4vcode.commentScan.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "node_modules",
                        ".git",
                        ".hg",
                        ".svn",
                        ".next",
                        ".nuxt",
                        ".output",
                        ".svelte-kit",
                        ".angular",
                        ".expo",
                        ".astro",
                        ".vitepress",
                        ".docusaurus",
                        ".parcel-cache",
                        "storybook-static",
                        "dist",
                        "build",
                        "out",
                        "coverage",
                        ".vscode-test",
                        "vendor",
                        "__pycache__",
                        ".mypy_cache",
                        ".pytest_cache",
                        ".tox",
                        ".eggs",
                        ".nox",
                        ".venv",
                        "venv",
                        "env",
                        "site-packages",
                        "__pypackages__",
                        ".ruff_cache",
                        ".pyre",
                        "htmlcov",
                        "target",
                        "bin",
                        "obj",
                        "Pods",
                        ".gradle",
                        ".dart_tool",
                        ".flutter",
                        ".pub-cache",
                        ".terraform",
                        "bower_components",
                        ".cache",
                        "tmp",
                        ".turbo",
                        ".vercel"
                    ],
                    "scope": "resource",
                    "markdownDescription": "Directories and glob patterns to exclude from the automatic comment scan, with [.gitignore](https://git-scm.com/docs/gitignore) semantics.\n\n- A plain directory name (e.g. `vendor`) matches any `vendor/` directory at any depth, like `**/vendor/**`.\n- Full globs are supported too, e.g. `**/vendor/**`, `src/legacy/**`, `**/*.test.ts`.\n- Prefix a pattern with `!` to re-include something a previous pattern excluded (the last matching pattern wins).\n\nThe defaults cover common framework output and dependency directories. Add your own project-specific exclusions here."
                },
                "todo4vcode.sharedTasks.enabled": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Store tasks in a workspace file so they can be shared and versioned with Git."
                },
                "todo4vcode.sharedTasks.path": {
                    "type": "string",
                    "default": ".todo4vcode/shared-tasks.json",
                    "scope": "resource",
                    "description": "Relative path from workspace root for the shared tasks file."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npm run compile:ts && npm run compile:sass",
        "compile:ts": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p ./",
        "compile:sass": "sass media/styles/main.scss media/styles/main.css --style=compressed",
        "watch": "tsc -watch -p ./ & sass --watch media/styles/main.scss media/styles/main.css",
        "package": "vsce package",
        "publish": "vsce publish && ovsx publish",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/vsce": "^3.7.1",
        "eslint": "^8.41.0",
        "ovsx": "^0.10.7",
        "sass": "^1.97.1",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.44",
        "minimatch": "^3.1.2"
    }
}
